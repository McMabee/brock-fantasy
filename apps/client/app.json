{
  "expo": {
    "name": "Brock Fantasy",
    "slug": "brock-fantasy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "brockfantasy",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ca.brocku.fantasy"
    },
    "android": {
      "package": "ca.brocku.fantasy",
      "adaptiveIcon": {
        "backgroundColor": "#071811"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "fantasy-updates"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    }
  }
}
