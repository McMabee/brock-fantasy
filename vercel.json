{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build:web",
  "outputDirectory": "apps/client/dist/client",
  "proxy": {
    "entrypoint": "proxy.ts"
  },
  "functions": {
    "api/index.js": {
      "maxDuration": 120,
      "includeFiles": "apps/client/dist/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "redirects": [
    {
      "source": "/policies/cookie-policy.html",
      "destination": "/cookies",
      "permanent": true
    }
  ]
}
