{
  "name": "brock-fantasy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @brock-fantasy/client start",
    "web": "pnpm --filter @brock-fantasy/client web",
    "android": "pnpm --filter @brock-fantasy/client android",
    "ios": "pnpm --filter @brock-fantasy/client ios",
    "build:web": "pnpm --filter @brock-fantasy/client build:web",
    "smoke:mobile": "pnpm --filter @brock-fantasy/client smoke:mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:sql": "node scripts/validate-sql.mjs",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @brock-fantasy/domain test",
    "test:coverage": "pnpm --filter @brock-fantasy/domain test:coverage",
    "test:edge:local": "node scripts/test-edge-functions.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm lint:sql && pnpm typecheck && pnpm test && pnpm build:web && pnpm smoke:mobile"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "pgsql-parser": "18.2.6",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
