{
  "name": "brock-fantasy",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @brock-fantasy/client start",
    "web": "pnpm --filter @brock-fantasy/client web",
    "android": "pnpm --filter @brock-fantasy/client android",
    "ios": "pnpm --filter @brock-fantasy/client ios",
    "build:web": "node --experimental-strip-types scripts/verify-web-build-config.mjs --build",
    "preview": "pnpm --filter @brock-fantasy/client preview",
    "smoke:mobile": "pnpm --filter @brock-fantasy/client smoke:mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:sql": "node scripts/validate-sql.mjs",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "pnpm --filter @brock-fantasy/domain test && pnpm test:import",
    "test:import": "node --experimental-strip-types --test scripts/lib/*.test.mjs",
    "test:ui": "node --experimental-strip-types scripts/test-ui-browser.mjs",
    "test:draft-controls:browser": "node --experimental-strip-types scripts/test-draft-controls-browser.mjs",
    "test:draft-status:api:local": "node --experimental-strip-types scripts/test-draft-status-api-local.mjs",
    "test:matchup-recovery:local": "node --experimental-strip-types scripts/test-matchup-recovery-local.mjs --browser",
    "test:late-draft:local": "node scripts/test-matchup-recovery-local.mjs --rest-only --late-draft",
    "test:supabase-optimization:local": "node --experimental-strip-types scripts/test-supabase-optimization-local.mjs",
    "test:varsity:browser": "node --experimental-strip-types scripts/test-varsity-browser.mjs",
    "test:player-metrics:local": "node --experimental-strip-types scripts/test-height-publication-local.mjs",
    "test:roster-metrics:local": "node --experimental-strip-types scripts/test-roster-metrics-local.mjs",
    "import:heights": "node --experimental-strip-types scripts/materialize-brock-heights.mjs",
    "import:player-metrics": "node --experimental-strip-types scripts/materialize-brock-roster-metrics.mjs",
    "research:heights": "node --experimental-strip-types scripts/research-brock-heights.mjs",
    "test:publication:local": "node scripts/test-import-publication-local.mjs",
    "test:rosters:local": "node scripts/test-roster-materialization-local.mjs",
    "test:public-beta:local": "node --experimental-strip-types scripts/test-public-beta-local.mjs",
    "test:draft-concurrency:local": "node scripts/test-draft-concurrency-local.mjs",
    "test:web-auth:local": "node scripts/test-web-auth-throttle.mjs",
    "test:admin:local": "node --experimental-strip-types scripts/test-admin-local.mjs",
    "test:beta-boundary": "node scripts/test-beta-boundary.mjs",
    "test:registration:local": "node scripts/test-registration-migrations.mjs",
    "test:roster-rest:local": "node --experimental-strip-types scripts/test-league-roster-rest.mjs",
    "test:coverage": "pnpm --filter @brock-fantasy/domain test:coverage",
    "test:edge:local": "node scripts/test-edge-functions.mjs",
    "verify:auth-config": "node --experimental-strip-types scripts/verify-supabase-auth-config.mjs",
    "verify:web-env-boundary": "node scripts/verify-web-env-boundary.mjs",
    "import:beta-data": "node scripts/import-brock-beta-data.mjs",
    "import:rosters": "node scripts/materialize-brock-rosters.mjs",
    "import:schedules": "node scripts/materialize-brock-schedules.mjs",
    "import:headshots": "node scripts/materialize-brock-headshots.mjs",
    "research:official-data": "node scripts/research-brock-official-data.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm lint:sql && pnpm typecheck && pnpm test && pnpm test:beta-boundary && pnpm build:web && pnpm verify:web-env-boundary && pnpm test:web-auth:local && pnpm test:admin:local && pnpm smoke:mobile",
    "test:launch:browser": "node --experimental-strip-types scripts/test-launch-browser.mjs",
    "test:privacy:browser": "node scripts/test-privacy-accessibility-browser.mjs",
    "test:scheduled-auto:local": "node scripts/test-registration-migrations.mjs --automatic-drafts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@types/node": "22.19.17",
    "@vitest/coverage-v8": "5.0.1",
    "cheerio": "1.2.0",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "pgsql-parser": "18.2.6",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@vercel/functions": "3.9.11",
    "expo-server": "57.0.3"
  }
}
