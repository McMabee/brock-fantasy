# Public Expo values. These are safe identifiers, not service-role credentials.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_SUPPORT_EMAIL=fantasy-support@example.ca

# Server-only values belong in the Supabase or CI secret store, never in an
# EXPO_PUBLIC variable or client bundle.
SPORTS_PROVIDER_BASE_URL=https://provider.example/api
SPORTS_PROVIDER_TOKEN=replace-in-secret-store
SPORTS_PROVIDER_WEBHOOK_SECRET=replace-in-secret-store
