# PUBLIC browser configuration: Expo can embed every EXPO_PUBLIC_* value in
# shipped JavaScript. In Vercel choose Type=Config (visibility=config), NOT Secret.
# - Vercel Preview builds require separate origins and an explicit backend choice
# - Scope feature-preview values to their Git branch and supply them during build
# - See docs/preview-environment.md for required settings and hosted acceptance
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_APP_ORIGIN=http://localhost:8081
EXPO_PUBLIC_SUPPORT_EMAIL=bfa.support64@gmail.com

# Server-only values belong in the Vercel, Supabase or CI secret store, never in an
# EXPO_PUBLIC variable or client bundle.
# In Vercel choose Type=Secret (visibility=secret), scoped to Preview/beta and
# separately to Production when launching the live site. Read only at runtime.
# Required for hosted web authentication. Use the same HMAC secret on both hosts
# to keep their shared limiter buckets aligned. Generate at least 32 random bytes
# (the code requires at least 32 non-whitespace characters). Do not use placeholders.
SUPABASE_SECRET_KEY=replace-in-server-secret-store
AUTH_RATE_LIMIT_HMAC_SECRET=replace-with-private-random-secret
# Administrator invitation delivery uses Resend and a verified sender domain.
# Set these server-only values on each Vercel environment that sends invitations.
RESEND_API_KEY=replace-in-server-secret-store
ADMIN_INVITE_EMAIL_FROM=Brock Fantasy <admin@your-verified-domain.ca>
# - Service delivery stays disabled until the staged release checks pass
SERVICE_EMAIL_FROM=Brock Fantasy <service@your-verified-domain.ca>
SERVICE_EMAIL_WORKER_SECRET=replace-with-private-random-secret
SERVICE_EMAIL_UNSUBSCRIBE_SECRET=replace-with-separate-private-random-secret
RESEND_WEBHOOK_SECRET=replace-with-provider-signing-secret
SUPPORT_EMAIL_TO=bfa.support64@gmail.com
SPORTS_PROVIDER_BASE_URL=https://provider.example/api
SPORTS_PROVIDER_TOKEN=replace-in-secret-store
SPORTS_PROVIDER_WEBHOOK_SECRET=replace-in-secret-store
